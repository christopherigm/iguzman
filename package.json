{
  "name": "iguzman",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "new-app": "bash cli/new-nextjs-app/new-nextjs-app.sh",
    "new-api": "bash cli/new-django-app/new-django-app.sh",
    "new-tv-app": "bash cli/new-smarttv-app/new-smarttv-app.sh",
    "new-rn-app": "bash cli/new-rn-app/new-rn-app.sh",
    "new-site": "bash cli/new-site/new-site.sh",
    "setup-minecraft": "bash cli/setup-minecraft/setup-minecraft.sh",
    "tv-cert": "bash cli/tv-cert/tv-cert.sh",
    "tv-deploy": "bash cli/tv-deploy/tv-deploy.sh",
    "helm": "bash cli/helm/helm.sh",
    "secrets": "bash cli/setup-k8s-secrets/setup-k8s-secrets.sh",
    "logs": "bash cli/logs/logs.sh",
    "sync-website-hosts": "bash cli/website/website.sh sync",
    "publish-site": "bash cli/website/website.sh publish",
    "pull-site": "bash cli/website/website.sh pull",
    "deploy-app": "bash cli/deploy-app/deploy-app.sh",
    "disk-cleanup": "bash cli/disk-cleanup/disk-cleanup.sh",
    "django-superuser": "bash cli/django-superuser/django-superuser.sh",
    "deploy-postgres": "bash cli/deploy-postgres/deploy-postgres.sh",
    "deploy-mongodb": "bash cli/deploy-mongodb/deploy-mongodb.sh",
    "deploy-mysql": "bash cli/deploy-mysql/deploy-mysql.sh",
    "deploy-redis": "bash cli/deploy-redis/deploy-redis.sh",
    "deploy-garage": "bash cli/deploy-garage/deploy-garage.sh",
    "upload-s3": "bash cli/upload-s3/upload-s3.sh",
    "setup-wifi": "bash cli/setup-wifi/setup-wifi.sh",
    "dev-services": "bash cli/dev-services/dev-services.sh",
    "generate-icons": "bash cli/generate-icons/generate-icons.sh",
    "edit-videos": "bash cli/edit-videos/edit-videos.sh"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mongodb": "^7.5.0",
    "next": "16.2.11"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": ">=7.29.6 <8",
      "@ungap/structured-clone@<1.3.1": ">=1.3.1",
      "@swc/helpers": ">=0.5.23",
      "ajv@<6.14.0": "^6.14.0",
      "brace-expansion@<5.0.8": ">=5.0.8",
      "fast-uri@<3.1.4": ">=3.1.4 <4",
      "find-my-way@<9.7.0": ">=9.7.0",
      "js-yaml@<4.3.0": ">=4.3.0 <5",
      "minimatch@<10.2.3": ">=10.2.3",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.18": ">=8.5.18",
      "sharp@<0.35.3": ">=0.35.3"
    }
  }
}
