# syntax=docker.io/docker/dockerfile:1

FROM node:22-alpine AS base

# ---------------------------------------------------------------------------
# Stage 1 - Prune the monorepo so only packages needed by "video-downloader" are kept.
# This avoids installing unnecessary workspace dependencies.
# ---------------------------------------------------------------------------
FROM base AS pruner
RUN npm install -g turbo@^2
WORKDIR /app
COPY . .
RUN turbo prune video-downloader --docker

# ---------------------------------------------------------------------------
# Stage 2 - Install production + build dependencies (cached layer).
# Only the pruned package.json files and lockfile are copied so that
# source-code changes do not invalidate this layer.
# ---------------------------------------------------------------------------
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY --from=pruner /app/out/json/ ./
RUN corepack enable pnpm && pnpm i --no-frozen-lockfile

# ---------------------------------------------------------------------------
# Stage 3 - Build the Next.js application.
# ---------------------------------------------------------------------------
FROM base AS builder
WORKDIR /app

COPY --from=deps /app/ ./
COPY --from=pruner /app/out/full/ ./

ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable pnpm && pnpm exec turbo run build --filter=video-downloader --no-daemon

# @swc/helpers is resolved via Node.js conditional package exports at runtime,
# so Next.js static file tracing misses it in pnpm monorepos.
# pnpm stores @swc/helpers as a symlink inside next@*/node_modules/, so:
#   - use `find -L` to follow symlinks during traversal (matches -type d on symlinked dirs)
#   - increase maxdepth to 5 to account for symlink resolution adding one level
#   - use `cp -rL` to dereference symlinks when copying so the real files land in the image
RUN find -L /app/node_modules/.pnpm -maxdepth 5 \
      -path "*/next@*/node_modules/@swc/helpers" -type d \
    | while read src; do \
        rel="${src#/app/}"; \
        dest="/app/apps/video-downloader/.next/standalone/${rel}"; \
        mkdir -p "$dest"; \
        cp -rL "$src/." "$dest/"; \
      done

# ---------------------------------------------------------------------------
# Stage 4 - Minimal production image.
# Uses the standalone output so node_modules are NOT copied.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Runtime system dependencies
RUN apk add --no-cache \
    ffmpeg \
    curl \
    jq \
    wget \
    python3 \
    py3-pip \
    ttf-dejavu

# Force the yt-dlp/gallery-dl layer to rebuild whenever a new yt-dlp release
# ships. BuildKit revalidates a remote ADD against the source's ETag/Last-Modified,
# so this JSON changes the moment a new release is published, invalidating the
# cache for the pip layer below and pulling the newest version every build.
# CACHEBUST stays as a manual override: pass --build-arg CACHEBUST=$(date +%s)
# (or any new value) to force a re-pull even when no new release exists.
ADD https://api.github.com/repos/yt-dlp/yt-dlp/releases/latest /tmp/yt-dlp-release.json
ARG CACHEBUST=1
# curl_cffi is pinned below 0.14 on purpose. The TikTok extractor requests its
# webpage with impersonate=True, which is an *empty* ImpersonateTarget meaning
# "match any" - and because that empty target is truthy it takes precedence over
# --impersonate, so the flag cannot be used to steer this. yt-dlp then resolves
# it to the first entry of _SUPPORTED_IMPERSONATE_TARGET_MAP, i.e. the newest
# target curl_cffi offers. curl_cffi 0.14 added chrome142, and TikTok's WAF
# answers that fingerprint with a 537-byte "Site Maintenance" page instead of
# the video page, which surfaces as the misleading
#   ERROR: [TikTok] <id>: Unexpected response from webpage request
# (the challenge solver bails because there is no challenge markup to parse).
# Every other target - chrome131 and older, safari, firefox, edge - still works.
# Holding curl_cffi at 0.13.x keeps chrome142 out of the map so the default
# resolves to chrome-131:macos-14.
# Re-check on yt-dlp upgrades: once chrome142 lands in _DEPRIORITIZED_TARGETS in
# yt_dlp/networking/_curlcffi.py, this pin can be dropped.
RUN pip install --break-system-packages --no-cache-dir --upgrade \
    "yt-dlp[default,curl-cffi]" \
    "curl_cffi<0.14" \
    gallery-dl

# Copy only what the standalone server needs
COPY --from=builder /app/apps/video-downloader/public ./apps/video-downloader/public
COPY --from=builder /app/apps/video-downloader/.next/standalone ./
COPY --from=builder /app/apps/video-downloader/.next/static ./apps/video-downloader/.next/static

COPY apps/video-downloader/scripts/coupon /usr/local/bin/coupon
RUN chmod +x /usr/local/bin/coupon

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js is generated by `next build` when output is "standalone"
CMD ["node", "apps/video-downloader/server.js"]
