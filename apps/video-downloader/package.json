{
  "name": "video-downloader",
  "version": "0.2.281",
  "type": "module",
  "private": true,
  "scripts": {
    "gen:breakpoints": "pnpm --filter @repo/ui gen:breakpoints",
    "predev": "pnpm gen:breakpoints",
    "dev": "next dev --port 3000",
    "dev:stripe": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "prebuild": "pnpm gen:breakpoints",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "upgrade-yt-dlp": "pip install --user --upgrade \"yt-dlp[default,curl-cffi]\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/lib-storage": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@repo/helpers": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/ui": "workspace:*",
    "@serwist/next": "^9.5.12",
    "music-metadata": "^11.14.0",
    "next-intl": "^4.13.4",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.3.2",
    "swiper": "^12.2.0",
    "next": "16.2.11"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.4",
    "postcss-custom-media": "^12.0.1",
    "serwist": "^9.5.12",
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  }
}
