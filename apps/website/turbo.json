{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "passThroughEnv": [
        "API_URL",
        "LOG_LEVEL",
        "MEDIA_PROXY_HOSTS",
        "SCRAPER_URL",
        "SCRAPER_API_KEY",
        "TAVILY_API_KEY"
      ]
    },
    "dev": {
      "passThroughEnv": [
        "API_URL",
        "DEV_SITE",
        "LOG_LEVEL",
        "MEDIA_PROXY_HOSTS",
        "SCRAPER_URL",
        "SCRAPER_API_KEY",
        "TAVILY_API_KEY"
      ]
    }
  }
}
