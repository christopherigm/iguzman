DOCKER_REGISTRY=christopherguzman
NAMESPACE=animals

# Django API base URL - server-side only, never NEXT_PUBLIC_
# Local: http://localhost:8000
API_URL=http://localhost:8000

# ─── Video pipeline ─────────────────────────────────────────
# This app transcodes uploaded sighting clips itself: the browser sends them in
# ≤90 MB chunks to /api/video/upload, ffmpeg re-encodes them here, and the result
# is PUT straight to R2. animals-api never sees the file. See lib/video-pipeline.ts.

# Scratch for in-flight uploads and transcodes. An emptyDir in the cluster; falls
# back to the OS temp directory locally.
VIDEO_SCRATCH_DIR=/scratch

# Ceiling on a source clip, mirroring animals-api's MAX_VIDEO_UPLOAD_MB.
MAX_VIDEO_UPLOAD_MB=5000

# Longest clip the public contribute flow accepts, in seconds. ⚠ Must match
# animals-api's MAX_CONTRIBUTION_VIDEO_SECONDS: that one is the enforcing copy,
# this one is what the picker displays and refuses on before the upload starts.
# Read on the server and passed to the form as a prop - deliberately not
# NEXT_PUBLIC_, which would inline it when the image is built and make this
# value inert. Unset falls back to 90, the same default animals-api uses.
MAX_CONTRIBUTION_VIDEO_SECONDS=600

# How many uploads one pod holds at once. A *disk* budget - the scratch volume's
# sizeLimit is (this x MAX_VIDEO_UPLOAD_MB) plus the output - not a CPU one;
# transcodes are serialised one at a time regardless.
MAX_CONCURRENT_UPLOADS=4

# ⚠ Must be the identical value as VIDEO_HANDLER_TOKEN in animals-api. It both
# verifies the upload tickets that API issues and signs the status callbacks
# going back. Mismatched, every upload is refused and every clip stays
# "processing" until it times out. Empty, uploads do not work at all - neither
# side falls open.
VIDEO_HANDLER_TOKEN=sample-video-token

# R2, for writing the transcoded clip and its poster frame. Same bucket
# animals-api reads from; the keys are built to its upload_to conventions.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
