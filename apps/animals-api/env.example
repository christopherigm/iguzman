# Docker / Helm
DOCKER_REGISTRY=christopherguzman
NAMESPACE=animals

# Django
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=animals_api.settings

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://animals.iguzman.com.mx
CSRF_TRUSTED_ORIGINS=https://animals-api.iguzman.com.mx,https://animals.iguzman.com.mx
FRONTEND_URL=https://animals.iguzman.com.mx

# Database (leave DB_PASSWORD empty to use SQLite locally - the host below is
# only dialed when a password is set, so this file works as-is on a laptop)
DB_HOST=postgres.animals.svc.cluster.local
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Media (uploaded files, DEVELOPMENT ONLY - see R2 below)
# Leave this unset. Django defaults MEDIA_ROOT to BASE_DIR/media, which is
# apps/animals/media locally (gitignored) and /app/media in the container -
# the right answer in both places, with no CWD sensitivity. Set it only to send
# uploads somewhere else, and never to an empty string: os.environ.get returns
# '' rather than the default, and Path('') is the current directory.
# MEDIA_ROOT=

# What a relative media URL is resolved against when there is no request - the
# logo embedded in a branded email. Only used in the no-R2 (development) mode;
# with R2 on, every FileField.url is already absolute.
MEDIA_BASE_URL=https://animals-api.iguzman.com.mx

# Cloudflare R2 - the ONLY media store in production. Every uploaded file goes
# to the bucket and is served from the CDN; R2_PUBLIC_DOMAIN is the custom
# hostname mapped to it in Cloudflare (without one, URLs fall back to expiring
# signed links, which defeats the CDN).
#
# Leave R2_ACCOUNT_ID EMPTY in development: with it unset, uploads go to
# MEDIA_ROOT above and none of the rest is read. NEVER leave it empty in the
# cluster - the pod has no persistent volume, so uploads would land on the
# container filesystem and be lost on the next rollout.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=r2.iguzman.com.mx

# Largest video file a sighting's gallery accepts, in MB. Images ride in JSON as
# base64 and are capped by DATA_UPLOAD_MAX_MEMORY_SIZE instead; only the
# multipart video endpoint reads this. The ingress `proxy-body-size` annotation
# must stay above it, or nginx refuses the upload before Django can explain why.
MAX_VIDEO_UPLOAD_MB=200

# Cache (leave REDIS_PASSWORD empty to use the local-memory cache - the URL
# below is only dialed when a password is set)
REDIS_URL=redis://redis.animals.svc.cluster.local:6379/0
REDIS_PASSWORD=

# API response caching. Defaults to off while DEBUG=True, so an edit made in the
# Django admin is on the next page load instead of up to 5 minutes later; on
# otherwise. Set it to True to reproduce the production caching path locally.
# API_CACHE_ENABLED=True

# Email (leave EMAIL_HOST_USER empty to use the console backend)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.ionos.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=animals.iguzman.com.mx
WEBAUTHN_RP_NAME=Animals
WEBAUTHN_RP_ORIGIN=https://animals-api.iguzman.com.mx

# AI providers. Every LLM call runs in this backend (core/services/llm.py):
# Groq first, OpenRouter as the fallback. With both empty, the /api/ai/*
# endpoints answer 503 instead of streaming - they are staff-only authoring
# tools, so the rest of the API is unaffected.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_REQUEST_TIMEOUT=20

# Web research for POST /api/ai/research/, via the shared `scraper` service.
# Optional: leave SCRAPER_API_KEY empty and research still answers, from the
# model's own knowledge and with no source links.
SCRAPER_BASE_URL=https://scraper.iguzman.com.mx
SCRAPER_API_KEY=
