{
  "name": "website-api",
  "version": "0.1.179",
  "scripts": {
    "venv": "source venv/bin/activate",
    "requirements": "pip install -r requirements.txt",
    "static": "python3 manage.py collectstatic --noinput",
    "migrate": "python3 manage.py migrate",
    "migrations": "python3 manage.py makemigrations",
    "superuser": "python3 manage.py createsuperuser",
    "dev": "python3 manage.py runserver 0.0.0.0:8000",
    "dev:stripe": "stripe listen --forward-to localhost:8000/api/orders/stripe/webhook/${SYSTEM_ID:-1}/",
    "seed-site": "python3 manage.py seed_site",
    "freeze": "pip freeze > requirements.txt"
  }
}
