# Docker / Helm
DOCKER_REGISTRY=christopherguzman
NAMESPACE=website

# Django
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=website_api.settings
DJANGO_ADMIN_USER=
DJANGO_ADMIN_PASSWORD=

# CORS / CSRF (leave CORS_ALLOWED_ORIGINS empty to allow all origins when DEBUG=True)
CORS_ALLOWED_ORIGINS=https://bdrone.com.mx,https://website.iguzman.com.mx
CSRF_TRUSTED_ORIGINS=https://website-api.iguzman.com.mx,https://website.iguzman.com.mx
FRONTEND_URL=https://website.iguzman.com.mx/

# Database (leave DB_HOST empty to use SQLite locally)
DB_HOST=
DB_PORT=5432
DB_NAME=website
DB_USER=website
DB_PASSWORD=

# Media (uploaded files)
MEDIA_ROOT=/app/media
# Origin for relative media URLs in contexts with no request (branded emails).
# Ignored once R2 is on - the storage backend returns absolute URLs already.
MEDIA_BASE_URL=https://website-api.iguzman.com.mx

# Cloudflare R2 media storage. Leave R2_ACCOUNT_ID EMPTY in development: with it
# unset, uploads go to MEDIA_ROOT above and none of the rest is read. Setting it
# switches images and backup archives to R2 for every tenant that has not
# connected its own bucket in the CMS (/admin/system -> Storage).
# R2_PUBLIC_DOMAIN is the custom hostname mapped to the bucket in Cloudflare;
# without it URLs fall back to expiring signed links, which defeats the CDN.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Hosts under this suffix are our own sites and belong on the platform bucket
# above; anything else is a customer on its own domain, expected to connect its
# own R2 account in the CMS. Decides which bucket the /admin/system media
# migration targets, and therefore what must be configured before it will run.
PLATFORM_HOST_SUFFIX=.iguzman.com.mx

# Cache (leave REDIS_URL empty to use the local-memory cache)
REDIS_URL=redis://redis.website.svc.cluster.local:6379/0
REDIS_PASSWORD=

# Email (leave EMAIL_HOST_USER empty to use the console backend)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.ionos.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Stripe (per-System keys live encrypted in the DB, not here)
STRIPE_CREDENTIALS_ENCRYPTION_KEY=
STRIPE_CHECKOUT_SESSION_TTL=1800

# LLM providers (Groq primary, OpenRouter fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_REQUEST_TIMEOUT=20

# Scraper microservice (web search + page extract) - powers the ingredient
# "Search on web" nutrition lookup. Shared with cinelog-api.
SCRAPER_BASE_URL=https://scraper.iguzman.com.mx
SCRAPER_API_KEY=
