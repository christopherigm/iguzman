# Docker / Helm
DOCKER_REGISTRY=christopherguzman
NAMESPACE=website

# Django
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=website_api.settings
DJANGO_ADMIN_USER=
DJANGO_ADMIN_PASSWORD=

# CORS / CSRF (leave CORS_ALLOWED_ORIGINS empty to allow all origins when DEBUG=True)
CORS_ALLOWED_ORIGINS=https://bdrone.com.mx,https://website.iguzman.com.mx
CSRF_TRUSTED_ORIGINS=https://website-api.iguzman.com.mx,https://website.iguzman.com.mx
FRONTEND_URL=https://website.iguzman.com.mx/

# Database (leave DB_HOST empty to use SQLite locally)
DB_HOST=
DB_PORT=5432
DB_NAME=website
DB_USER=website
DB_PASSWORD=

# Media (uploaded files, DEVELOPMENT ONLY - see R2 below)
MEDIA_ROOT=media
# Origin for relative media URLs in contexts with no request (branded emails).
# Only reached in development: with R2 on, the storage backend returns absolute
# URLs already.
MEDIA_BASE_URL=https://website-api.iguzman.com.mx

# Cloudflare R2 media storage - the ONLY media store in production. Every image
# and backup archive goes to R2 for every tenant that has not connected its own
# bucket in the CMS (/admin/system -> Storage).
# R2_PUBLIC_DOMAIN is the custom hostname mapped to the bucket in Cloudflare;
# without it URLs fall back to expiring signed links, which defeats the CDN.
#
# Leave R2_ACCOUNT_ID EMPTY in development: with it unset, uploads go to
# MEDIA_ROOT above and none of the rest is read. NEVER leave it empty in the
# cluster - the pod has no persistent volume any more, so uploads would land on
# the container filesystem and be lost on the next rollout.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Cache (leave REDIS_URL empty to use the local-memory cache)
REDIS_URL=redis://redis.website.svc.cluster.local:6379/0
REDIS_PASSWORD=

# Email (leave EMAIL_HOST_USER empty to use the console backend)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.ionos.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Stripe (per-System keys live encrypted in the DB, not here)
STRIPE_CREDENTIALS_ENCRYPTION_KEY=
STRIPE_CHECKOUT_SESSION_TTL=1800

# LLM provider (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
LLM_REQUEST_TIMEOUT=20

# Scraper microservice (web search + page extract) - powers the ingredient
# "Search on web" nutrition lookup. Shared with cinelog-api.
SCRAPER_BASE_URL=https://scraper.iguzman.com.mx
SCRAPER_API_KEY=

# Stock image banks - two consumers: `manage.py fetch_seed_images` (the
# /seed-site step that fills a new customer's brief with real photography) and
# the CMS's own image picker (/api/stock-images/*), which an operator uses to
# find a photo for a record they are editing. Both keys are free and instant:
# https://www.pexels.com/api/ and https://pixabay.com/api/docs/
# The picker runs in the cluster, so these DO belong in website-api-secrets now
# (`pnpm secrets`) - without them it answers 503 NO_IMAGE_BANK and the CMS says
# so. With neither key set, seeding falls back to the placeholder-* pool.
PEXELS_API_KEY=
PIXABAY_API_KEY=
